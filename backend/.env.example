# Copy this file to .env and replace every placeholder with your local value.
# Never commit .env or share database passwords and API keys.

# Supabase PostgreSQL connection
# Supabase Dashboard -> Connect -> Session pooler.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Required by the current application configuration
MPESA_CONSUMER_KEY=<mpesa-consumer-key>
MPESA_CONSUMER_SECRET=<mpesa-consumer-secret>
MPESA_SHORTCODE=<mpesa-shortcode>
MPESA_PASSKEY=<mpesa-passkey>

# Optional integrations
OPENAI_API_KEY=